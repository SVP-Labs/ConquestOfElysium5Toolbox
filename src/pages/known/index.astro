---
import Base from "../../layouts/Base.astro";
import known from "../../data/known.json";
import data from "../../../modcheck/data/commands.json";
import engineData from "../../../modcheck/data/engine.json";

const game = engineData.meta.game;
const hasPage = (name) => name in data.commands || engineData.added.includes(name);
---

<Base
  title="Mechanics"
  description={`How Conquest of Elysium 5 ${game} handles abilities, rituals and events, checked against the game itself.`}
>
  <h1>Mechanics</h1>
  <p class="lede">What the manual leaves open, checked against the CoE5 {game} game.</p>

  <nav class="toc" aria-label="Questions">
    <ol>
      {known.entries.map((e) => (
        <li><a href={`#${e.slug}`}>{e.question}</a></li>
      ))}
    </ol>
  </nav>

  {known.entries.map((e) => (
    <section class="entry" id={e.slug}>
      <h2>{e.question}</h2>
      <p class="meta">
        {e.commands.map((c) =>
          hasPage(c) ? <a class="cmd" href={`/commands/${encodeURIComponent(c)}`}>{c}</a> : <span class="cmd">{c}</span>,
        )}
      </p>
      {e.answer.map((p) => <p>{p}</p>)}
    </section>
  ))}

  <h2 id="game-only">Undocumented commands</h2>
  <p>Not in the manual, but the {game} game accepts them:</p>
  <p class="cmds">
    {engineData.added.map((c) => <a class="cmd" href={`/commands/${encodeURIComponent(c)}`}>{c}</a>)}
  </p>

  <h2 id="not-in-game">Commands that don't exist</h2>
  <p>Listed in the manual or older data, but not in the {game} game; a mod using one fails to load:</p>
  <p class="cmds">
    {engineData.removed.map((c) => <a class="cmd" href={`/commands/${encodeURIComponent(c)}`}>{c}</a>)}
  </p>
</Base>

<style>
  .lede,
  .entry p {
    max-width: 44rem;
  }

  .toc ol {
    padding-left: 1.2rem;
    max-width: 44rem;
  }

  .toc li {
    margin-bottom: 0.2rem;
  }

  .entry {
    margin-top: 2rem;
    scroll-margin-top: 4.5rem;
  }

  .meta,
  .cmds {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
  }

  .cmd {
    font-family: var(--mono);
    font-size: 0.92rem;
  }
</style>
