---
import Base from "../../layouts/Base.astro";
import data from "../../../modcheck/data/vanilla.json";
import schools from "../../data/ritual-schools.json";

const tables = [
  {
    kind: "monsters",
    title: "Monsters",
    count: Object.keys(data.monsters).length,
    desc: "Every unit and commander in the base game, numbered from 0.",
  },
  {
    kind: "weapons",
    title: "Weapons",
    count: Object.keys(data.weapons).length,
    desc: "Weapon and attack numbers, from Fist upwards.",
  },
  {
    kind: "items",
    title: "Items",
    count: Object.keys(data.items).length,
    desc: "Magic item numbers used by item and reward commands.",
  },
  {
    kind: "rituals",
    title: "Rituals",
    count: Object.keys(data.rituals).length,
    desc: "Ritual numbers — numbering starts at 1, not 0.",
  },
  {
    kind: "terrains",
    title: "Terrains",
    count: Object.keys(data.terrains).length,
    desc: "Terrain and location numbers used by map and event commands.",
  },
  {
    kind: "classes",
    title: "Classes",
    count: Object.keys(data.classes).length,
    desc: "The playable classes — numbering starts at 1, not 0.",
  },
  {
    kind: "resources",
    title: "Resources",
    count: data.resources.length,
    desc: "Resource numbers — the number is the position in the game's resource list.",
  },
  {
    kind: "schools",
    title: "Ritual schools",
    count: Object.keys(schools).length,
    desc: "Ritual school (pow) numbers with their names, from Necromancy to the Raksharaja.",
  },
];

// Section icon — matches the Data nav link in Base.astro.
const dataIcon =
  '<svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 10v10M15 10v10" /></svg>';
---

<Base
  title="Data"
  description="Searchable ID tables for Conquest of Elysium 5 modding: every monster, weapon, item, ritual, terrain, class and resource number with the name it refers to."
>
  <h1><Fragment set:html={dataIcon} /> ID tables</h1>

  <p>
    The mod format refers to game content by number. These tables list every
    numeric ID the base game defines, with the name each number refers to — so
    a line like <code>power 6 2</code> can be read without digging through the
    PDF.
  </p>

  <div class="cards">
    {
      tables.map((t) => (
        <a class="card" href={`/data/${t.kind}`}>
          <h2>{t.title}</h2>
          <p class="dim card-count">{t.count} entries</p>
          <p>{t.desc}</p>
        </a>
      ))
    }
  </div>

  <p class="dim schools-note">
    A <code>school</code> argument outside the ritual schools table is most
    likely not a base-game school — the data comes from an older game version,
    so newer additions may be missing.
  </p>
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .card {
    display: block;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    color: var(--text);
    box-shadow: var(--shadow);
    transition: transform 150ms ease, box-shadow 150ms ease,
      border-color 150ms ease;
  }

  .card:hover {
    text-decoration: none;
    border-color: var(--accent-dim);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    color: var(--link);
  }

  .card:hover h2 { text-decoration: underline; }

  .card p {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .card-count {
    font-size: 0.82rem;
    margin-bottom: 0.5rem;
  }


</style>
