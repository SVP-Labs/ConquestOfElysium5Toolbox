---
import Base from "../../../layouts/Base.astro";
import monsters from "../../../data/source-monsters.json";
import commandTable from "../../../../modcheck/data/commands.json";

export function getStaticPaths() {
  const entries = Object.entries(monsters);
  return entries.map(([idx, { name, block }], i) => ({
    params: { idx },
    props: {
      idx: Number(idx),
      name,
      block,
      prev: i > 0 ? { idx: entries[i - 1][0], name: entries[i - 1][1].name } : null,
      next: i < entries.length - 1 ? { idx: entries[i + 1][0], name: entries[i + 1][1].name } : null,
    },
  }));
}

const { idx, name, block, prev, next } = Astro.props;
const known = new Set(Object.keys(commandTable.commands));

const escapeHtml = (s) =>
  s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");

// Build-time highlighting: the command word links to its reference page,
// strings and numbers get classes. Nested quotes inside a descr render as
// alternating string spans — a display quirk the copy button is immune to,
// since it copies the text content. Commands are padded to a per-block
// column so the values align (real spaces, so copies keep the alignment).
const lines = block.split("\n");
const pad = Math.max(
  ...lines.map((l) => (l.indexOf(" ") < 0 ? l.length : l.indexOf(" "))),
);

const renderLine = (line) => {
  const space = line.indexOf(" ");
  const cmd = space < 0 ? line : line.slice(0, space);
  const rest = space < 0 ? "" : " ".repeat(pad - cmd.length) + line.slice(space);
  const cmdHtml = known.has(cmd)
    ? `<a href="/commands/${encodeURIComponent(cmd)}">${escapeHtml(cmd)}</a>`
    : escapeHtml(cmd);
  const restHtml = rest
    .split('"')
    .map((part, i) =>
      i % 2 === 1
        ? `<span class="str">&quot;${escapeHtml(part)}&quot;</span>`
        : escapeHtml(part).replace(
            /(^| )(-?\d+)(?=$| )/g,
            (_, pre, num) => `${pre}<span class="num">${num}</span>`,
          ),
    )
    .join("");
  return cmdHtml + restHtml;
};

const blockHtml = lines.map(renderLine).join("\n");
const descr = /descr "([^]*?)"(?:\n|$)/.exec(block)?.[1];
const pageDescription = descr
  ? `${name} (monster ${idx}) mod source. ${descr.replaceAll("^", " ").slice(0, 140)}…`
  : `Full mod-format definition of ${name}, monster ${idx} in Conquest of Elysium 5.`;
---

<Base title={`${name} — source`} description={pageDescription}>
  <h1>{name} <span class="dim mon-idx">monster {idx}</span></h1>

  <p class="nav-row">
    <a href={`/data/monsters#n${idx}`}>&larr; All monsters</a>
    {prev && <a href={`/source/monsters/${prev.idx}`}>&larr; {prev.name}</a>}
    {next && <a href={`/source/monsters/${next.idx}`}>{next.name} &rarr;</a>}
  </p>

  <p class="dim">
    The complete definition of this monster in the game's own mod format —
    every line is a real mod command, so the block can be pasted into a mod
    file and adapted. Command names link to the
    <a href="/commands">reference</a>.
  </p>

  <div class="src-wrap">
    <button type="button" id="copy" class="copy-btn">Copy block</button>
    <pre class="src" id="block"><Fragment set:html={blockHtml} /></pre>
  </div>

  <p class="dim credit">
    Record definition from the base game data (v5.33 extraction), shown with
    Illwinter's permission. Unaffiliated with Illwinter Game Design.
  </p>
</Base>

<script>
  const btn = document.getElementById("copy");
  btn.addEventListener("click", async () => {
    await navigator.clipboard.writeText(document.getElementById("block").textContent);
    btn.textContent = "Copied";
    setTimeout(() => (btn.textContent = "Copy block"), 1500);
  });
</script>

<style>
  .mon-idx {
    font-size: 1rem;
    font-weight: 400;
    margin-left: 0.35em;
  }

  .nav-row {
    margin-top: -0.5rem;
    font-size: 0.9rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .src-wrap {
    position: relative;
    margin-top: 1rem;
  }

  .copy-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-size: 0.8rem;
    padding: 0.25rem 0.7rem;
  }

  .src {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1rem 1.25rem;
    font-family: var(--mono);
    font-size: 0.9rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .src :global(a) {
    font-weight: 600;
  }

  .src :global(.str) {
    color: var(--text-dim);
  }

  .src :global(.num) {
    color: var(--accent);
  }

  .credit {
    font-size: 0.82rem;
  }
</style>
