---
import Base from "../../layouts/Base.astro";
import data from "../../../modcheck/data/commands.json";

const { meta, commands } = data;
const names = Object.keys(commands).sort();
const total = names.length;
const sections = [...new Set(Object.values(commands).flatMap((c) => c.sections))].sort();

// Section icon — matches the Commands nav link in Base.astro.
const commandsIcon =
  '<svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" /><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" /></svg>';
---

<Base
  title="Commands"
  description={`Full reference for all ${total} Conquest of Elysium 5 mod commands: signatures, arguments, manual pages and base-game usage.`}
>
  <h1><Fragment set:html={commandsIcon} /> Command reference</h1>
  <p class="dim subtitle">
    {total} commands · from {meta.manual} and {meta.rips}
  </p>

  <div class="controls">
    <div class="controls-row">
      <input
        type="search"
        id="q"
        placeholder="Search commands…"
        aria-label="Search commands by name"
        autocomplete="off"
      />
      <select id="section" aria-label="Filter by section">
        <option value="all">all sections</option>
        {sections.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>
    <div class="controls-row filters">
      <label><input type="checkbox" id="f-unused" /> never used by the base game</label>
      <label><input type="checkbox" id="f-undocumented" /> to be documented</label>
      <label><input type="checkbox" id="f-notes" /> has data notes</label>
    </div>
    <p class="dim count" id="count">showing {total} of {total}</p>
  </div>

  <ul class="cmd-list" id="list">
    {
      names.map((name) => {
        const c = commands[name];
        return (
          <li
            data-name={name}
            data-sections={c.sections.join(",")}
            data-attested={c.attested}
            data-documented={c.documented ? "1" : "0"}
            data-notes={c.notes ? "1" : "0"}
          >
            {/* Some command names are generic words (start, free, name…),
                which trips Lighthouse's uninformative-link-text audit. That
                audit reads the visible text, so the clarifying suffix is
                real (hidden) text rather than an aria-label. */}
            <a class="cmd-name" href={`/commands/${name}`}>
              {name}<span class="visually-hidden"> command</span>
            </a>
            <span class="row-badges">
              {c.sections.map((s) => (
                <span class="badge">{s}</span>
              ))}
              {!c.documented && <span class="badge accent">to be documented</span>}
              {c.notes && <span class="badge accent">data note</span>}
            </span>
          </li>
        );
      })
    }
  </ul>
</Base>

<script>
  import { distance } from "../../../modcheck/src/suggest.js";

  const rows = [...document.querySelectorAll("#list > li")].map((el) => ({
    el,
    name: el.dataset.name,
    sections: el.dataset.sections.split(","),
    attested: Number(el.dataset.attested),
    documented: el.dataset.documented === "1",
    notes: el.dataset.notes === "1",
  }));

  const q = document.getElementById("q");
  const sectionSel = document.getElementById("section");
  const fUnused = document.getElementById("f-unused");
  const fUndoc = document.getElementById("f-undocumented");
  const fNotes = document.getElementById("f-notes");
  const count = document.getElementById("count");
  const total = rows.length;

  function apply() {
    const query = q.value.trim().toLowerCase();
    const section = sectionSel.value;
    const fuzzy = query.length >= 3;
    let shown = 0;

    for (const row of rows) {
      let ok = true;
      if (query) {
        ok =
          row.name.includes(query) ||
          (fuzzy && distance(query, row.name, 2) <= 2);
      }
      if (ok && section !== "all") ok = row.sections.includes(section);
      if (ok && fUnused.checked) ok = row.attested === 0;
      if (ok && fUndoc.checked) ok = !row.documented;
      if (ok && fNotes.checked) ok = row.notes;
      row.el.hidden = !ok;
      if (ok) shown++;
    }

    count.textContent = `showing ${shown} of ${total}`;
  }

  q.addEventListener("input", apply);
  for (const el of [sectionSel, fUnused, fUndoc, fNotes]) {
    el.addEventListener("change", apply);
  }
</script>

<style>
  .subtitle {
    margin-top: -0.5rem;
  }

  .controls {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--bg);
    padding: 0.5rem 0 0.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.5rem;
  }

  .controls-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  #q {
    flex: 1 1 14rem;
    min-width: 10rem;
  }

  .filters {
    font-size: 0.9rem;
    color: var(--text-dim);
    gap: 1.25rem;
  }

  .filters label {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    cursor: pointer;
  }

  .count {
    margin: 0;
    font-size: 0.85rem;
  }

  .cmd-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cmd-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.3rem 0.25rem;
    border-bottom: 1px solid var(--border);
  }

  .cmd-list li[hidden] {
    display: none;
  }

  .cmd-name {
    font-family: var(--mono);
    font-size: 0.92rem;
    min-width: 12rem;
  }

  .row-badges {
    display: inline-flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-left: auto;
  }


  @media (max-width: 40rem) {
    .cmd-name {
      min-width: 0;
    }
  }
</style>
