---
import Base from "../../layouts/Base.astro";
import data from "../../../modcheck/data/commands.json";
import allExamples from "../../data/examples.json";
import manualDescriptions from "../../data/command-descriptions.json";
import authoredDescriptions from "../../data/command-descriptions-overrides.json";
import interactions from "../../data/command-interactions.json";
import interactionGroups from "../../data/interaction-groups.json";
import spellsByPath from "../../data/spells.json";
import spellPaths from "../../data/spell-paths.json";
import weaponsByIndex from "../../data/weapons-index.json";
import { spellRelationsFor } from "../../lib/spell-display.js";
import { SECTION_TIPS, STATUS_TIPS } from "../../lib/badge-tips.js";
import { distance } from "../../../modcheck/src/suggest.js";

export function getStaticPaths() {
  return Object.keys(data.commands).map((name) => ({ params: { name } }));
}

const { name } = Astro.params;
const cmd = data.commands[name];

const examples = allExamples[name] ?? [];
const notes = cmd.notes ? (Array.isArray(cmd.notes) ? cmd.notes : [cmd.notes]) : [];

// "What it does": the manual's own prose where it has any; hand-curated
// text from the overrides file wins where present (the curation contract —
// regeneration never touches the overrides). An override is a plain string,
// or {text, source} when the default source label does not fit.
const override = authoredDescriptions[name];
const purpose = override
  ? [
      typeof override === "string"
        ? { text: override, source: "authored" }
        : { text: override.text, source: "authored", label: override.source, scale: override.scale },
    ]
  : (manualDescriptions[name] ?? []).map((p) => ({ ...p, source: "manual" }));

const signatureLine = cmd.signature ? `${name} ${cmd.signature}` : name;

let description = purpose.length
  ? `CoE5 mod command ${name}: ${purpose[0].text}`
  : cmd.signature
    ? `CoE5 mod command ${name} — ${cmd.signature}`
    : `CoE5 mod command ${name}`;
if (description.length > 150) description = description.slice(0, 149) + "…";

// "Interacts with": curated mechanic groups this command belongs to, plus
// name-mention edges mined from the description texts (each carrying the
// sentence that connects the two commands). Mention edges already covered
// by a shared group are dropped.
const myGroups = interactionGroups.filter((g) => g.members.includes(name));
const grouped = new Set(myGroups.flatMap((g) => g.members));
const mentionEdges = (interactions[name] ?? []).filter((e) => !grouped.has(e.with));
// Combat spells whose weapon record carries a restriction touching this tag
// (e.g. undead-only spells on the undead page).
const spellRelations = spellRelationsFor(name, spellsByPath, spellPaths, weaponsByIndex);

const stem = (n) => n.replace(/^\+/, "").replace(/\d+$/, "");
const myStem = stem(name);
const related = Object.keys(data.commands)
  .filter((other) => {
    if (other === name) return false;
    if (myStem.length >= 2 && stem(other) === myStem) return true;
    const sharesSection = data.commands[other].sections.some((s) =>
      cmd.sections.includes(s)
    );
    return sharesSection && distance(name, other, 2) <= 2;
  })
  .sort()
  .slice(0, 8);

const pagesLabel =
  cmd.pages.length === 0
    ? null
    : cmd.pages.length === 1
      ? `manual page ${cmd.pages[0]}`
      : `pages ${cmd.pages.join(", ")}`;
---

<Base title={name} description={description}>
  <h1 class="cmd-title">{name}</h1>

  <p class="badges">
    {cmd.sections.map((s) => (
      <span class="badge" title={SECTION_TIPS[s]}>
        {s}
      </span>
    ))}
    {pagesLabel && <span class="dim pages">{pagesLabel}</span>}
    {!cmd.documented && (
      <span class="badge accent" title={STATUS_TIPS.undocumented}>
        to be documented
      </span>
    )}
  </p>

  <pre class="signature">{signatureLine}</pre>

  {
    notes.length > 0 && (
      <aside class="callout">
        <strong>Data note</strong>
        {notes.map((n) => (
          <p>{n}</p>
        ))}
        <p class="dim caveat">
          The data source is a community extraction of game version
          {" " + (data.meta.rips.match(/v([\d.]+)/)?.[1] ?? "unknown")},
          compared against {data.meta.manual}, so treat this as a hint
          rather than a definitive statement of what the game does.
        </p>
      </aside>
    )
  }

  <h2>Arguments</h2>
  {
    cmd.args.length === 0 ? (
      <p class="dim">Takes no arguments.</p>
    ) : (
      <>
        <table>
          <thead>
            <tr>
              <th>Argument</th>
              <th>Type</th>
              <th>Required</th>
              <th>References</th>
            </tr>
          </thead>
          <tbody>
            {cmd.args.map((a) => (
              <tr>
                <td>{a.name}</td>
                <td class="type">{a.types.join(" or ")}</td>
                <td>{a.optional ? "optional" : "yes"}</td>
                <td>{a.ref === "self" ? "the kind the block defines" : (a.ref ?? "—")}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="dim arity">
          {cmd.arity.min === cmd.arity.max
            ? `Takes ${cmd.arity.min} argument${cmd.arity.min === 1 ? "" : "s"}.`
            : `Takes ${cmd.arity.min}–${cmd.arity.max} arguments.`}
        </p>
      </>
    )
  }

  {
    purpose.length > 0 && (
      <>
        <h2>What it does</h2>
        {purpose.map((p) => (
          <div class="purpose">
            <p>{p.text}</p>
            {p.scale && (
              <table class="purpose-scale">
                <tbody>
                  {p.scale.map(([icon, range]) => (
                    <tr>
                      <td class="scale-icon">{icon}</td>
                      <td>{range}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            <p class="dim purpose-src">
              {p.source === "manual"
                ? `— modding manual${p.page ? `, page ${p.page}` : ""}${
                    p.section && p.section !== "mod" ? ` (as ${/^[aeiou]/.test(p.section) ? "an" : "a"} ${p.section} command)` : ""
                  }`
                : p.label
                  ? `— ${p.label}`
                  : "— toolbox note, written from base-game usage"}
            </p>
          </div>
        ))}
      </>
    )
  }

  {
    examples.length > 0 && (
      <>
        <h2>From the base game data</h2>
        {examples.map((ex) => (
          <div class="example">
            <span class="dim kind">{ex.kind} data</span>
            <pre>{ex.text}</pre>
          </div>
        ))}
      </>
    )
  }

  {
    (myGroups.length > 0 || mentionEdges.length > 0) && (
      <>
        <h2>Interacts with</h2>
        {myGroups.map((g) => (
          <div class="interaction">
            <p class="interaction-members">
              {g.members
                .filter((m) => m !== name)
                .map((m) => (
                  <a href={`/commands/${encodeURIComponent(m)}`}>
                    {m}<span class="visually-hidden"> command</span>
                  </a>
                ))}
            </p>
            <p class="interaction-note">{g.note}</p>
            <p class="dim interaction-src">— {g.source}</p>
          </div>
        ))}
        {mentionEdges.map((e) => (
          <div class="interaction">
            <p class="interaction-members">
              <a href={`/commands/${encodeURIComponent(e.with)}`}>
                {e.with}<span class="visually-hidden"> command</span>
              </a>
            </p>
            <p class="interaction-note">“{e.sentence}”</p>
            <p class="dim interaction-src">— {e.source}</p>
          </div>
        ))}
      </>
    )
  }

  {
    spellRelations.length > 0 && (
      <>
        <h2>Spell interactions</h2>
        {spellRelations.map((r) => (
          <div class="interaction">
            <p class="interaction-note">{r.relation}:</p>
            <p class="interaction-members">
              {r.spells.map((sp) => (
                <a href={`/data/spells#${sp.anchor}`} title={sp.pathName}>
                  {sp.name}
                </a>
              ))}
            </p>
            <p class="dim interaction-src">
              — targeting flags on the spells' weapon records; wording per the manual
            </p>
          </div>
        ))}
      </>
    )
  }

  {
    related.length > 0 && (
      <>
        <h2>Related</h2>
        <p class="related">
          {related.map((r) => (
            <a href={`/commands/${r}`}>
              {r}<span class="visually-hidden"> command</span>
            </a>
          ))}
        </p>
      </>
    )
  }

  <p class="back">
    <a href="/commands">← All commands</a>
  </p>
</Base>

<style>
  .cmd-title {
    font-family: var(--mono);
  }

  .purpose p {
    margin: 0 0 0.15rem;
    max-width: 44rem;
  }

  .purpose {
    margin-bottom: 0.9rem;
  }

  .purpose-src {
    font-size: 0.8rem;
  }

  .purpose-scale {
    margin: 0.4rem 0 0.35rem;
    width: auto;
  }

  .purpose-scale td {
    padding: 0.15rem 1.25rem 0.15rem 0;
    border: 0;
  }

  .scale-icon {
    white-space: nowrap;
    letter-spacing: 0.1em;
  }

  .interaction {
    margin-bottom: 1rem;
    max-width: 44rem;
  }

  .interaction p {
    margin: 0 0 0.15rem;
  }

  .interaction-members {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    font-family: var(--mono);
    font-size: 0.92rem;
  }

  .interaction-src {
    font-size: 0.8rem;
  }

  .badges {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: -0.5rem;
  }

  .pages {
    font-size: 0.85rem;
  }

  .signature {
    font-size: 0.95rem;
  }

  .callout {
    border: 1px solid var(--accent-dim);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
    padding: 0.6rem 1rem;
    margin: 1rem 0;
    font-size: 0.92rem;
  }

  .callout strong {
    color: var(--accent);
    display: block;
    margin-bottom: 0.25rem;
  }

  .callout p {
    margin: 0.25rem 0;
  }

  .callout .caveat {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .type {
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  .arity {
    font-size: 0.88rem;
  }

  .example {
    margin: 0.75rem 0;
  }

  .example .kind {
    font-size: 0.8rem;
  }

  .example pre {
    margin: 0.2rem 0 0;
  }

  .related {
    display: flex;
    gap: 0.5rem 1.25rem;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.92rem;
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
