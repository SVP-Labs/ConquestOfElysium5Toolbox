---
import "../styles/global.css";

const { title, description = "Browser tools for Conquest of Elysium 5 modders: validate mod files and browse the full command reference.", noindex = false } = Astro.props;

const SITE_NAME = "Conquest of Elysium 5 Toolbox";
const path = Astro.url.pathname;
const current = (prefix) =>
  (prefix === "/" ? path === "/" : path.startsWith(prefix)) ? "page" : undefined;

// Section icons — inline SVG, stroke inherits the link colour.
const iconAttrs =
  'class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const icons = {
  validator: `<svg ${iconAttrs}><circle cx="12" cy="12" r="9" /><path d="m8.5 12.3 2.4 2.4 4.6-5.2" /></svg>`,
  play: `<svg ${iconAttrs}><circle cx="12" cy="12" r="9" /><path d="m10 8.5 6 3.5-6 3.5z" /></svg>`,
  commands: `<svg ${iconAttrs}><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z" /><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z" /></svg>`,
  data: `<svg ${iconAttrs}><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 10v10M15 10v10" /></svg>`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Theme bootstrap — must run before first paint. Dark is the default:
      // no stored preference leaves data-theme unset and the :root tokens apply.
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} — ${SITE_NAME}` : SITE_NAME}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="48axZb8hpyc0tlmgkft3tVYaQl3wHwG7lKVD8DQl6uo" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="site-title" href="/">{SITE_NAME}</a>
        <nav class="site-nav">
          <a href="/check" aria-current={current("/check")}><Fragment set:html={icons.validator} />Validator</a>
          <a href="/commands" aria-current={current("/commands")}><Fragment set:html={icons.commands} />Commands</a>
          <a href="/data" aria-current={current("/data")}><Fragment set:html={icons.data} />Data</a>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" />
              <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <span>Every check runs in your browser — nothing is ever uploaded.</span>
        <a href="https://github.com/SvenPGH/ConquestOfElysium5ModValidator">Validator (CLI)</a>
        <a href="/impressum">Impressum</a>
        <a href="/privacy">Privacy</a>
        <span>Unaffiliated with Illwinter Game Design.</span>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        function currentTheme() {
          return document.documentElement.dataset.theme === "light" ? "light" : "dark";
        }
        function updateLabel() {
          btn.setAttribute(
            "aria-label",
            currentTheme() === "light" ? "Switch to dark theme" : "Switch to light theme"
          );
        }
        btn.addEventListener("click", function () {
          var next = currentTheme() === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch (e) {}
          updateLabel();
        });
        updateLabel();
      })();
    </script>
  </body>
</html>
